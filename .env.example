# Copiá este archivo a .env.local y completá con los datos de tu proyecto
# de Supabase (Project Settings → API). Ver el README para el paso a paso.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-public

# Opcional: si se define, la app pide este PIN de 4 dígitos antes de
# mostrar el selector de usuario. Dejalo vacío para no pedir PIN.
NEXT_PUBLIC_APP_PIN=
